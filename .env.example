# Local development. Copy to .env at the repo root (git ignores it). Every app
# and script reads that one file; variables already set in your shell win.

# Dev database. `pnpm e2e` never uses it: it adds `_test` to the name
# (slop_fest_dev_test) and creates that database on the same server.
DATABASE_URL=postgres://localhost:5432/slop_fest_dev

# Optional: point e2e at another database. Its name must still end in _test.
# E2E_DATABASE_URL=postgres://localhost:5432/slop_fest_test

# Signs session cookies. 32 characters or more. e2e uses its own fixed value.
SESSION_SECRET=change-me-to-a-long-random-string-32+

# Only production sets APP_ENV=production. The app refuses to start when
# APP_ENV=production and E2E_MODE (the e2e sign-in seam) are both set.
# APP_ENV=
