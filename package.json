{
  "name": "slop-fest",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @slop/web dev",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p e2e",
    "lint": "eslint .",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "db:migrate": "node --env-file-if-exists=.env packages/db/src/migrate.ts",
    "db:generate": "pnpm --filter @slop/db generate",
    "factory:test": "node --test 'tools/factory/test/*.test.mjs'"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.6",
    "@playwright/test": "^1.65.1",
    "@slop/db": "workspace:*",
    "@types/node": "^24.19.2",
    "drizzle-orm": "^0.45.4",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
